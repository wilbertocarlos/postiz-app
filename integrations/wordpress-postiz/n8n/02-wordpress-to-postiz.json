      "id": "11c23ad9-733c-4802-a333-b3d58db3e091",
      "name": "WordPress webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [-1080, -220],
      "webhookId": "ec5c9067-694d-4d0c-9e94-8a29b10fcdf4"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const crypto = require('crypto');\nconst headers = $json.headers || {};\nconst body = $json.body || {};\nconst timestamp = String(headers['x-postiz-timestamp'] || '');\nconst supplied = String(headers['x-postiz-signature'] || '').replace(/^sha256=/, '');\nconst secret = $env.WORDPRESS_POSTIZ_WEBHOOK_SECRET;\nif (!secret || !timestamp || !supplied) throw new Error('Missing webhook authentication');\nif (Math.abs(Date.now() / 1000 - Number(timestamp)) > 300) throw new Error('Expired webhook timestamp');\nconst expected = crypto.createHmac('sha256', secret).update(`${timestamp}.${JSON.stringify(body)}`).digest('hex');\nconst left = Buffer.from(expected, 'hex');\nconst right = Buffer.from(supplied, 'hex');\nif (left.length !== right.length || !crypto.timingSafeEqual(left, right)) throw new Error('Invalid webhook signature');\nreturn { json: body };"
      },
      "id": "a21fb8ff-5fbb-44d6-b538-50d32219a0e1",
      "name": "Verify HMAC",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-840, -220]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\"accepted\":true}",
        "options": { "responseCode": 202 }
