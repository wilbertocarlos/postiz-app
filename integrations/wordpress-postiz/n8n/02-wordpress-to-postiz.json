    {
      "parameters": {
        "url": "={{ $env.WORDPRESS_SITE_URL.replace(/\\/$/, '') + '/wp-json/wp/v2/posts?status=publish&orderby=date&order=desc&per_page=100&_embed=wp:featuredmedia&after=' + encodeURIComponent(new Date(Date.now() - 86400000).toISOString()) }}",
        "options": { "timeout": 15000 }
      },
      "id": "c145f90c-e52c-4a91-b074-dbe6b913c08e",
      "name": "Fetch recent WordPress articles",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [-840, 180],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.all().map(item => item.json);\nconst posts = raw.length === 1 && Array.isArray(raw[0]) ? raw[0] : raw;\nreturn posts.map(post => {\n  const canonical = post.link;\n  const media = post._embedded?.['wp:featuredmedia']?.[0]?.source_url || '';\n  const siteId = $env.WORDPRESS_SITE_ID || new URL(canonical).hostname.replace(/[^a-z0-9_-]/gi, '-').toLowerCase();\n  return { json: {\n    site_id: siteId,\n    post_id: post.id,\n    canonical_url: canonical,\n    title: String(post.title?.rendered || '').replace(/<[^>]+>/g, ''),\n    excerpt: String(post.excerpt?.rendered || '').replace(/<[^>]+>/g, ' ').replace(/\\s+/g, ' ').trim(),\n    featured_image_url: media,\n    published_at: post.date,\n    event_key: `${siteId}:${post.id}`\n  } };\n});"
      },
      "id": "4c3c7dc2-3cb0-4535-bbf6-acf177ccfb3b",
      "name": "Normalize polled articles",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-600, 180]
    },
