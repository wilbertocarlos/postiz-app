    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const article = $json;\nif (!article.site_id || !article.post_id || !article.canonical_url || !article.title) throw new Error('Incomplete article payload');\nreturn { json: { ...article, event_key: `${article.site_id}:${article.post_id}` } };"
      },
