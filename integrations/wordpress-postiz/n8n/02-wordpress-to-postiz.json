      "id": "dc9aed07-9393-4e40-8133-41cf6f2396f3",
      "name": "Needs processing",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [360, 0]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const excerpt = String($json.excerpt || '').replace(/\\s+/g, ' ').trim();\nlet summary = excerpt.slice(0, 240);\nif (excerpt.length > 240) summary = summary.replace(/\\s+\\S*$/, '').trim();\nconst content = `${$json.title}\\n\\n${summary}\\n\\nLees het volledige artikel: ${$json.canonical_url}`;\nconst now = new Date();\nconst local = new Intl.DateTimeFormat('en-CA', { timeZone: 'Europe/Amsterdam', year: 'numeric', month: '2-digit', day: '2-digit' }).formatToParts(now).reduce((a, p) => ({ ...a, [p.type]: p.value }), {});\nlet cursor = new Date(Date.UTC(Number(local.year), Number(local.month) - 1, Number(local.day) + 1, 10));\nwhile ([0, 6].includes(cursor.getUTCDay())) cursor.setUTCDate(cursor.getUTCDate() + 1);\nconst desiredUtc = Date.UTC(cursor.getUTCFullYear(), cursor.getUTCMonth(), cursor.getUTCDate(), 10);\nconst zonedParts = new Intl.DateTimeFormat('en-US', { timeZone: 'Europe/Amsterdam', year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit', second: '2-digit', hourCycle: 'h23' }).formatToParts(new Date(desiredUtc)).reduce((a, p) => ({ ...a, [p.type]: p.value }), {});\nconst representedUtc = Date.UTC(Number(zonedParts.year), Number(zonedParts.month) - 1, Number(zonedParts.day), Number(zonedParts.hour), Number(zonedParts.minute), Number(zonedParts.second));\nconst scheduled = new Date(desiredUtc - (representedUtc - desiredUtc)).toISOString();\nreturn { json: { ...$json, summary, content, scheduled } };"
      },
