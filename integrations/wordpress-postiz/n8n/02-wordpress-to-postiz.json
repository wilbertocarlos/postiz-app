        "jsCode": "const article = $('Prepare draft').item.json;\nconst uploaded = $json?.path ? { id: $json.id, name: $json.name, path: $json.path, alt: article.title } : null;\nreturn { json: { ...article, postiz_payload: {\n  type: 'draft',\n  date: article.scheduled,\n  shortLink: false,\n  tags: [],\n  posts: [{\n    integration: { id: $env.POSTIZ_LINKEDIN_PAGE_INTEGRATION_ID },\n    settings: { __type: 'linkedin-page', link_preview: true, post_as_images_carousel: false },\n    value: [{ content: article.content, image: uploaded ? [uploaded] : [], delay: 0 }]\n  }]\n} } };"
